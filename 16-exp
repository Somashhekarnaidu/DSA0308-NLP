import spacy

# Load the English language model
nlp = spacy.load("en_core_web_sm")

# Given text
text = "Elon Musk founded SpaceX in California in 2002."

# Process the text
doc = nlp(text)

# Display named entities
print("Named Entities:")

for ent in doc.ents:
    print(ent.text, "->", ent.label_)
